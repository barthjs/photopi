# Every variable can also be read from a file by appending _FILE to its name, e.g. APP_SECRET_FILE=/run/secrets/app_secret.

APP_NAME=PhotoPi
APP_ENV=production
APP_LANGUAGE=en
APP_SECRET=

LOG_LEVEL=warn
LOG_CHANNEL=stdout
LOG_PATH=/data/logs
LOG_FORMAT=json
LOG_MAX_SIZE_MB=100
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

CAMERA_SOURCE=webcam
CAMERA_CAPTURE_WIDTH=4000
CAMERA_CAPTURE_HEIGHT=2400
CAMERA_PREVIEW_WIDTH=800
CAMERA_PREVIEW_HEIGHT=480
CAMERA_PREVIEW_FPS=25
CAMERA_OVERLAY_PATH=
CAMERA_EXPOSURE_TIME=auto
CAMERA_EXPOSURE_MODE=normal
CAMERA_ANALOGUE_GAIN=0
CAMERA_EXPOSURE_COMPENSATION=0
CAMERA_WHITE_BALANCE=auto
CAMERA_HORIZONTAL_FLIP=false
CAMERA_VERTICAL_FLIP=false
CAMERA_ROTATION=0
CAMERA_JPEG_QUALITY=93
CAMERA_AUTOFOCUS_MODE=default
CAMERA_DENOISE=auto

CAPTURE_IMAGES_PER_RUN=4
CAPTURE_FILE_PREFIX=PhotoPi
CAPTURE_EVENT_NAME=PhotoPi
CAPTURE_WELCOME_MESSAGE=
CAPTURE_ADMIN_EMAIL=
CAPTURE_SAVE_ORIGINALS=true

MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
MAIL_MESSAGE_ID_DOMAIN=

PRINT_ENABLED=false
PRINT_PRINTER_NAME=
PRINT_LAYOUT=
PRINT_SUBMISSION_MODE=managed

SERVER_HOST=*
SERVER_PORT=8080
SERVER_TRUSTED_PROXIES="127.0.0.0/8,::1/128"
SERVER_CORS_ALLOWED_ORIGINS=
SERVER_CORS_ALLOW_CREDENTIALS=false
SERVER_SSL_ENABLED=false
SERVER_SSL_CERT_FILE=
SERVER_SSL_KEY_FILE=

SHARE_EMAIL_ENABLED=true
SHARE_EMAIL_SUBJECT=
SHARE_CLOUD_DRIVER=
SHARE_CLOUD_NEXTCLOUD_URL=
SHARE_CLOUD_NEXTCLOUD_USERNAME=
SHARE_CLOUD_NEXTCLOUD_PASSWORD=
SHARE_CLOUD_NEXTCLOUD_FOLDER=
SHARE_CLOUD_SELF_BASE_URL=

STORAGE_DRIVER=local
STORAGE_PATH=/data/storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_USE_PATH_STYLE=true

SYSTEM_SERVER_RESTART_COMMAND="systemctl --user restart photopi.service"
SYSTEM_SERVER_STOP_COMMAND="systemctl --user stop photopi.service"
SYSTEM_KIOSK_RESTART_COMMAND="systemctl --user restart photopi-kiosk.service"
SYSTEM_KIOSK_STOP_COMMAND="systemctl --user stop photopi-kiosk.service"
SYSTEM_ALL_RESTART_COMMAND="systemctl --user restart photopi.service photopi-kiosk.service"
SYSTEM_ALL_STOP_COMMAND="systemctl --user stop photopi-kiosk.service photopi.service"

THEME_PRIMARY=
THEME_SECONDARY=
THEME_SUCCESS=
THEME_INFO=
THEME_WARNING=
THEME_ERROR=
THEME_NEUTRAL=

CONFIG_FILE=/data/config.yaml

PUID=1000
PGID=1000
